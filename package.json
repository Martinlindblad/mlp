{
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:prod": "nodemon -x \"next build && next start\"",
    "build": "next build",
    "start": "next start",
    "lint": "run-p -cls --aggregate-output lint:*",
    "lint:eslint-check": "eslint-config-prettier \"src/**/*.js\"",
    "lint:prettier": "prettier -c \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "lint:eslint": "eslint src --report-unused-disable-directives --color",
    "lint:tsc": "tsc --noEmit --pretty",
    "setup-db": "ts-node scripts/setupSchema.ts",
    "postinstall": "patch-package"
  },
  "nodemonConfig": {
    "ext": "js,jsx,ts,tsx,json,css,scss,svg",
    "watch": [
      "src",
      "next.config.js",
      "fetchlangpacks.js",
      ".env"
    ],
    "ignore": [
      "src/buildtimeData/*.json"
    ]
  },
  "dependencies": {
    "@iconify/react": "^4.1.1",
    "@svgr/webpack": "^6.5.1",
    "@typescript-eslint/eslint-plugin": "^6.7.3",
    "@typescript-eslint/parser": "^6.7.3",
    "@vercel/speed-insights": "^1.0.1",
    "axios": "^1.2.2",
    "flowbite": "^1.6.0",
    "framer-motion": "^8.0.2",
    "mongodb": "^6.1.0",
    "next": "^13.5.3",
    "next-themes": "^0.2.1",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-query": "^3.39.2",
    "react-youtube": "^10.1.0",
    "sharp": "^0.31.3",
    "swiper": "^10.3.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.3",
    "@types/node": "^18.7.18",
    "@types/react": "^18.0.27",
    "autoprefixer": "^10.4.13",
    "eslint": "^8.23.1",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-next": "^13.5.11",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.8",
    "nodemon": "^2.0.19",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.20",
    "postcss-import": "^15.0.0",
    "prettier": "^2.7.1",
    "tailwindcss": "^3.2.4",
    "tailwindcss-rtl": "^0.9.0",
    "typescript": "^5.2.2"
  }
}
