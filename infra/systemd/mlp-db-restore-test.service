[Unit]
Description=MLP monthly isolated PostgreSQL restore test
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/mlp-restore-test
TimeoutStartSec=2h
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
ProtectHostname=true
NoNewPrivileges=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/mlp /etc/mlp /var/lib/mlp/backup-reports
ReadWritePaths=/run/lock/mlp-operations.lock /run/docker.sock /etc/mlp/compose-secrets /var/lib/mlp/restore-work /var/lib/mlp/restore-reports

[Install]
WantedBy=multi-user.target
